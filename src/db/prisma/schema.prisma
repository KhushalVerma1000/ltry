generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model AdminUser {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


model User {
  id                Int           @id @default(autoincrement())
  publicId          String        @unique @default(cuid())
  name              String
  phone             String        @unique
  password          String
  bankAccountNumber String
  bankIFSCCode      String
  upiId             String
  refreshToken      String
  walletBalance     Decimal       @default(0) @db.Decimal(12, 2)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  bookings          Booking[]
  ledgerEntries     LedgerEntry[]
}

model Pool {
  id           Int         @id @default(autoincrement())
  publicId     String      @unique @default(cuid())
  name         String
  perSeatPrice Decimal     @db.Decimal(10, 2)
  totalSeats   Int
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  rounds       PoolRound[]
}

model PoolRound {
  id            Int         @id @default(autoincrement())
  publicId      String      @unique @default(cuid())
  poolId        Int
  roundNumber   Int
  status        RoundStatus @default(UPCOMING)
  startsAt      DateTime
  endsAt        DateTime
  drawnAt       DateTime?
  priceSnapshot Decimal     @db.Decimal(10, 2)
  seatsSnapshot Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  pool          Pool        @relation(fields: [poolId], references: [id], onDelete: Restrict)
  seats         Seat[]
  bookings      Booking[]
  winners       Winner[]

  @@unique([poolId, roundNumber])
  @@index([poolId, status])
}

model Seat {
  id        Int        @id @default(autoincrement())
  publicId  String     @unique @default(cuid())
  roundId   Int
  poolId    Int
  name      String
  status    SeatStatus @default(AVAILABLE)
  bookingId String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  round     PoolRound    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  booking   Booking?     @relation(fields: [bookingId], references: [id])
  bookedSeats BookingSeat[]
  winners   Winner[]

  @@unique([roundId, name])
  @@index([roundId, status])
}

model Booking {
  id              String        @id @default(cuid())
  roundId         Int
  userId          Int
  amount          Decimal       @db.Decimal(10, 2)
  status          BookingStatus @default(PENDING)
  providerOrderId String?
  tokenExpiresAt  DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  round           PoolRound     @relation(fields: [roundId], references: [id], onDelete: Restrict)
  user            User          @relation(fields: [userId], references: [id], onDelete: NoAction)
  seats           Seat[]
  bookedSeats     BookingSeat[]
  transactions    Transaction[]

  @@index([roundId, status])
  @@index([userId])
}

model BookingSeat {
  id             Int      @id @default(autoincrement())
  bookingId      String
  seatId         Int
  roundId        Int
  poolId         Int
  seatName       String
  priceAtBooking Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: NoAction)
  seat           Seat     @relation(fields: [seatId], references: [id], onDelete: NoAction)

  @@unique([bookingId, seatId])
  @@index([roundId])
  @@index([poolId])
}


model Winner {
  id        Int       @id @default(autoincrement())
  roundId   Int
  poolId    Int
  seatId    Int
  position  Int
  prize     Decimal   @db.Decimal(10, 2)
  paid      Boolean   @default(false)
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  round     PoolRound @relation(fields: [roundId], references: [id], onDelete: Restrict)
  seat      Seat      @relation(fields: [seatId], references: [id], onDelete: NoAction)

  @@unique([roundId, position])
  @@index([roundId])
  @@index([poolId])
}


model Transaction {
  id                       String                   @id @default(cuid())
  bookingId                String
  paymentGateway           String
  gatewayOrderId           String
  gatewayPaymentId         String
  transactionAttemptStatus TransactionAttemptStatus @default(PENDING)
  amount                   Decimal                  @db.Decimal(10, 2)
  error                    Json?
  createdAt                DateTime                 @default(now())
  booking                  Booking                  @relation(fields: [bookingId], references: [id], onDelete: NoAction)

  @@index([bookingId])
}

enum RoundStatus {
  UPCOMING
  ACTIVE
  DRAWING
  CLOSED
  CANCELLED
}

enum SeatStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum BookingStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

enum TransactionAttemptStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

model LedgerEntry {
  id              String          @id @default(cuid())
  publicId        String          @unique @default(cuid())
  userId          Int
  type            LedgerEntryType
  direction       LedgerDirection
  amount          Decimal         @db.Decimal(12, 2)
  balanceAfter    Decimal         @db.Decimal(12, 2)
  referenceType   String
  referenceId     String?
  description     String?
  createdByAdminId String?
  createdAt       DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([referenceType, referenceId])
}

enum LedgerEntryType {
  BOOKING_PAYMENT
  BOOKING_REFUND
  WINNER_PAYOUT
  MANUAL_CREDIT
  MANUAL_DEBIT
}

enum LedgerDirection {
  CREDIT
  DEBIT
}
