generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String
  refreshToken String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


model User {
  id                Int       @id @default(autoincrement())
  publicId          String    @unique @default(cuid())
  name              String
  phone             String    @unique
  password          String
  bankAccountNumber String?
  bankIFSCCode      String?
  upiId             String?
  refreshToken      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  bookings          Booking[]
}

model Pool {
  id           Int      @id @default(autoincrement())
  name         String
  perSeatPrice Decimal  @db.Decimal(10, 2)
  totalSeats   Int
  publicId     String   @unique @default(cuid())
  validFromDate DateTime  @default(now())
  validToDate   DateTime  @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  seats        Seat[]
  winners      Winner[]
}

model BookingSeat {
  id        Int      @id @default(autoincrement())
  bookingId String
  seatId    Int
  seatName  String   // snapshot — in case seat is deleted later
  poolId    Int      // snapshot
  createdAt DateTime @default(now())

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: NoAction)
  seat      Seat     @relation(fields: [seatId], references: [id], onDelete: NoAction)

  @@unique([bookingId, seatId])
}
model Booking {
  id                String        @id @default(cuid())
  amount            Decimal       @db.Decimal(10, 2)
  providerPaymentId String?   @unique
  status            bookingStatus @default(PENDING)
  userId            Int
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: NoAction)
  seats             Seat[]        // keep for active/live relation
  bookedSeats       BookingSeat[] // permanent log ✅
}

model Seat {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  poolId      Int
  status      seatStatus   @default(AVAILABLE)
  bookingId   String?      
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  publicId    String       @unique @default(cuid())
  booking     Booking?     @relation(fields: [bookingId], references: [id])
  pool        Pool         @relation(fields: [poolId], references: [id], onDelete: Cascade)
  winners     Winner[]
  bookedSeats BookingSeat[] 
}


model Winner {
  id        Int      @id @default(autoincrement())
  date      DateTime @default(now())
  seatId    Int
  position  Int
  poolId    Int
  prize     Decimal  @db.Decimal(10, 2)
  paid Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seat      Seat     @relation(fields: [seatId], references: [id], onDelete: NoAction)
  pool      Pool     @relation(fields: [poolId], references: [id], onDelete: NoAction)
}




enum seatStatus {
  AVAILABLE
  RESERVED
  SOLD
}


enum bookingStatus {
  PENDING
  COMPLETED
  FAILED
}
