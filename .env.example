PORT=8000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/ltry

# Razorpay API keys (Dashboard > Settings > API Keys)
RAZERPAY_KEY_ID=
RAZERPAY_KEY_SECRET=

# Razorpay WEBHOOK secret (Dashboard > Settings > Webhooks). This is a different
# value from RAZERPAY_KEY_SECRET: you choose it when creating the webhook.
RAZERPAY_WEBHOOK_SECRET=
